rules_version = '2';
// Quizzoni : une seule collection, « progression ». Chaque personne connectée ne peut lire
// et écrire que son propre document (progression/<son uid>), qui contient deux champs :
// data (la progression en texte JSON, 500 ko au plus) et updatedAt (date de mise à jour).
service cloud.firestore {
  match /databases/{database}/documents {
    match /progression/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000;
    }
  }
}
